# Gemini Chat OAuth2 Configuration Template
# Copy this file to .env and fill in your actual values

# Google Gemini API Key (required)
GOOGLE_API_KEY=your_google_api_key_here

# Flask Secret Key (required - generate a secure random string)
SECRET_KEY=your_super_secret_key_change_this_in_production

# OAuth2 Provider Configuration
# Choose one: google, github, custom
OAUTH2_PROVIDER=google

# Google OAuth2 Settings (if using Google)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# GitHub OAuth2 Settings (if using GitHub)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Custom OAuth2 Settings (if using custom provider)
CUSTOM_CLIENT_ID=your_custom_client_id
CUSTOM_CLIENT_SECRET=your_custom_client_secret
CUSTOM_AUTHORIZATION_URL=https://your-provider.com/oauth/authorize
CUSTOM_TOKEN_URL=https://your-provider.com/oauth/token
CUSTOM_USERINFO_URL=https://your-provider.com/oauth/userinfo

# Authorization Settings
ENABLE_ROLE_BASED_ACCESS=true
DEFAULT_USER_ROLE=user
ADMIN_EMAILS=admin@example.com,another-admin@example.com

# Rate Limiting
ENABLE_RATE_LIMITING=true
RATE_LIMIT_PER_USER=100

# Instructions:
# 1. Copy this file to .env
# 2. Fill in your actual OAuth2 credentials
# 3. Set up OAuth2 application in your chosen provider:
#
# For Google:
# - Go to Google Cloud Console
# - Create OAuth2 credentials
# - Add authorized redirect URI: http://localhost:5000/auth/callback
#
# For GitHub:
# - Go to GitHub Settings > Developer settings > OAuth Apps
# - Create new OAuth App
# - Set Authorization callback URL: http://localhost:5000/auth/callback
#
# For Custom Provider:
# - Configure your OAuth2 provider with redirect URI: http://localhost:5000/auth/callback
